# ========================================================
# S.S. Global Public School - Environment Configuration
# Copy this template to .env in the project root:
#   cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. Database Configuration (MongoDB Atlas Only)
# --------------------------------------------------------
# Provide your MongoDB Atlas connection string.
# NOTE: Ensure your current public IP address is added to the IP Access List
# in the MongoDB Atlas Console (Security -> Network Access).
MONGO_URI=mongodb+srv://YOUR_ATLAS_USERNAME:YOUR_ATLAS_PASSWORD@YOUR_CLUSTER.mongodb.net/ss_global_school?retryWrites=true&w=majority

# --------------------------------------------------------
# 2. Authentication Secrets (Required)
# --------------------------------------------------------
# Must be a secure random string (minimum 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_2026
JWT_EXPIRES_IN=24h

# --------------------------------------------------------
# 3. Server & Network Configuration
# --------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# --------------------------------------------------------
# 4. Optional Administrator Email Shortcut
# --------------------------------------------------------
# (Optional alias shortcut for "admin" username logins)
ADMIN_EMAIL=

# --------------------------------------------------------
# 5. Cloudinary Media Storage (Optional)
# --------------------------------------------------------
# If omitted or invalid, media uploads automatically fall back
# to local disk storage in backend/uploads/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------------------
# 6. Frontend Build & Analytics (Optional)
# --------------------------------------------------------
VITE_API_URL=/api
VITE_GA_MEASUREMENT_ID=
