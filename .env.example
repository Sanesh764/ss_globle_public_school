# ========================================================
# Docker & Application Environment Configuration Template
# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env
# ========================================================

# --------------------------------------------------------
# Backend Configuration
# --------------------------------------------------------
PORT=5000
NODE_ENV=production

# Database Connection
# In Docker Compose, the service name 'mongo' is the host
MONGO_URI=mongodb://mongo:27017/ss_global_school

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_2026
JWT_EXPIRES_IN=24h

# Frontend Allowed Origin (for CORS)
FRONTEND_URL=http://localhost

# Admin Credentials (used by initial seeding scripts)
ADMIN_EMAIL=admin@ssglobalpublicschool.edu.in
ADMIN_PASSWORD=replace_with_secure_admin_password

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------
# Frontend Configuration (Vite Build Arguments)
# --------------------------------------------------------
# Use /api so Nginx reverse-proxies requests to the backend container
VITE_API_URL=/api
VITE_GA_MEASUREMENT_ID=your_google_analytics_measurement_id

# --------------------------------------------------------
# Docker Host Port Overrides (Optional)
# --------------------------------------------------------
FRONTEND_PORT=80
MONGO_PORT=27017
